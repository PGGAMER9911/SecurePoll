# Application Settings
APP_NAME=SecurePoll
APP_ENV=development
APP_URL=http://localhost/SecurePoll/public
APP_TIMEZONE=UTC

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=securepoll_db
DB_USERNAME=root
DB_PASSWORD=

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME="SecurePoll"

# Security Settings
# Generate a random 32-character string for production!
APP_KEY=your_random_32_character_app_key_here
